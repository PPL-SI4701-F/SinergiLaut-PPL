{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["es2015", "dom"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "types": ["cypress"]
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
