{
    "name": "ppl-sinergilaut",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "cross-env NODE_OPTIONS=--max-old-space-size=1536 next dev",
        "dev:turbo": "cross-env NODE_OPTIONS=--max-old-space-size=2048 next dev --turbo",
        "dev:lowmem": "cross-env NODE_OPTIONS=--max-old-space-size=1024 next dev",
        "build": "next build",
        "build:test": "cross-env NEXT_PUBLIC_E2E_TESTING=true next build",
        "dev:e2e": "node scripts/run-with-env.mjs .env.test.local next dev",
        "build:e2e": "node scripts/run-with-env.mjs .env.test.local next build",
        "start:e2e": "node scripts/run-with-env.mjs .env.test.local next start",
        "start": "next start",
        "start:test": "cross-env NEXT_PUBLIC_E2E_TESTING=true next start",
        "lint": "next lint",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:seed": "prisma db seed",
        "db:seed:pbi": "node scripts/run-with-env.mjs .env.test.local cross-env CYPRESS_SEED_ONLY=true cypress run --spec cypress/seeds/seed-all-pbi.cy.ts --browser electron && node scripts/run-with-env.mjs .env.test.local node scripts/fix-supabase-grants.js",
        "db:studio": "prisma studio",
        "db:reset": "prisma db push --force-reset && prisma db seed && node scripts/fix-supabase-grants.js",
        "cypress:open": "cypress open",
        "cypress:run": "cypress run",
        "cypress:open:e2e": "node scripts/run-with-env.mjs .env.test.local cypress open",
        "cypress:run:e2e": "node scripts/run-with-env.mjs .env.test.local cypress run"
    },
    "prisma": {
        "seed": "npx tsx prisma/seed.ts"
    },
    "dependencies": {
        "@hookform/resolvers": "^3.9.1",
        "@maplibre/maplibre-gl-geocoder": "^1.9.4",
        "@prisma/client": "^6.19.3",
        "@radix-ui/react-accordion": "1.2.12",
        "@radix-ui/react-alert-dialog": "1.1.15",
        "@radix-ui/react-aspect-ratio": "1.1.8",
        "@radix-ui/react-avatar": "1.1.11",
        "@radix-ui/react-checkbox": "1.3.3",
        "@radix-ui/react-collapsible": "1.1.12",
        "@radix-ui/react-context-menu": "2.2.16",
        "@radix-ui/react-dialog": "1.1.15",
        "@radix-ui/react-dropdown-menu": "2.1.16",
        "@radix-ui/react-hover-card": "1.1.15",
        "@radix-ui/react-label": "2.1.8",
        "@radix-ui/react-menubar": "1.1.16",
        "@radix-ui/react-navigation-menu": "1.2.14",
        "@radix-ui/react-popover": "1.1.15",
        "@radix-ui/react-progress": "1.1.8",
        "@radix-ui/react-radio-group": "1.3.8",
        "@radix-ui/react-scroll-area": "1.2.10",
        "@radix-ui/react-select": "2.2.6",
        "@radix-ui/react-separator": "1.1.8",
        "@radix-ui/react-slider": "1.3.6",
        "@radix-ui/react-slot": "1.2.4",
        "@radix-ui/react-switch": "1.2.6",
        "@radix-ui/react-tabs": "1.1.13",
        "@radix-ui/react-toast": "1.2.15",
        "@radix-ui/react-toggle": "1.1.10",
        "@radix-ui/react-toggle-group": "1.1.11",
        "@radix-ui/react-tooltip": "1.2.8",
        "@supabase/ssr": "^0.9.0",
        "@supabase/supabase-js": "^2.99.3",
        "@vercel/analytics": "1.6.1",
        "autoprefixer": "^10.4.20",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "1.1.1",
        "date-fns": "4.1.0",
        "dotenv": "^17.4.0",
        "embla-carousel-react": "8.6.0",
        "input-otp": "1.4.2",
        "lucide-react": "^0.564.0",
        "maplibre-gl": "^5.22.0",
        "next": "16.1.6",
        "next-themes": "^0.4.6",
        "react": "19.2.4",
        "react-day-picker": "9.13.2",
        "react-dom": "19.2.4",
        "react-hook-form": "^7.54.1",
        "react-resizable-panels": "^2.1.7",
        "recharts": "2.15.0",
        "sonner": "^1.7.1",
        "styled-jsx": "^5.1.7",
        "tailwind-merge": "^3.3.1",
        "vaul": "^1.1.2",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.2.0",
        "@types/node": "^22",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "cross-env": "^10.1.0",
        "cypress": "^15.15.0",
        "cypress-slow-down": "^1.4.0",
        "postcss": "^8.5",
        "postgres": "^3.4.8",
        "prisma": "^6.19.3",
        "tailwindcss": "^4.2.0",
        "ts-morph": "^28.0.0",
        "tsx": "^4.21.0",
        "tw-animate-css": "1.3.3",
        "typescript": "5.7.3"
    }
}
